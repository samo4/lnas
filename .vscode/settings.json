{
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null,
    "editor.codeActionsOnSave": {
      // Prettier registers a `source.fixAll.prettier` action, which the global
      // `"source.fixAll": "explicit"` would run on every save and rewrite
      // *emphasis* to _emphasis_ (plus reflow `$$` blocks). Never run it here;
      // `.prettierignore` is the second line of defence.
      "source.fixAll.prettier": "never",
      "source.fixAll.markdownlint": "explicit"
    }
  },
  "files.associations": {
    "justfile": "just"
  },
  "[just]": {
    "editor.formatOnSave": false,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[plaintext]": {
    "editor.formatOnSave": false
  },
  "runOnSave.commands": [
    {
      "globMatch": "AS.md",
      "command": "cd \"$(git rev-parse --show-toplevel)\" && just as",
      "runIn": "terminal",
      "terminalReveal": "onError"
    },
    {
      "globMatch": "*.md",
      "notMatch": "[\\\\/]AS\\.md$",
      "command": "cd \"$(git rev-parse --show-toplevel)\" && just ch \"${fileBasename}\"",
      "runIn": "terminal",
      "terminalReveal": "onError"
    }
  ]
}
